# Environment Variables for PitchCraft Backend
# Copy this file to .env and fill in your real values
# NEVER commit .env to GitHub!

# ── Google Gemini ──────────────────────────────────────────────
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# ── Supabase (Free tier is enough) ────────────────────────────
SUPABASE_URL=YOUR_SUPABASE_PROJECT_URL_HERE
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY_HERE

# ── Security ───────────────────────────────────────────────────
# A random secret string that your Chrome extension sends
# in every request so only your extension can use your server.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
EXTENSION_SECRET=YOUR_RANDOM_SECRET_HERE

# ── Settings ───────────────────────────────────────────────────
FREE_MONTHLY_LIMIT=10
PORT=3001

